# Local/default HTTP port. Railway injects PORT automatically.
PORT=3000

# Session cookie signing key. Replace in every deployed environment.
PORTAL_SESSION_SECRET=replace-with-at-least-32-random-characters

# First owner account. Only used while the users table is still empty; once any
# account exists these are ignored even if left set. The password is flagged as
# must-change on first login, and both values should be removed afterwards.
#
# PORTAL_DEMO_ACCESS_CODE was removed in M1: one shared code for every role meant
# anyone holding it had admin, and nothing recorded who did what. Each person now
# has an account and permissions come from user_role_assignments.
BOOTSTRAP_OWNER_PHONE=replace-with-owner-phone-number
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-temporary-password
BOOTSTRAP_OWNER_NAME=Quan tri he thong

# Railway: mount a persistent volume at /data and use /data/taopho88.sqlite.
# Local development can use ./data/taopho88.sqlite.
SQLITE_PATH=./data/taopho88.sqlite
# Railway Volume: mount /data, ảnh catalog được lưu bền vững ở thư mục này.
UPLOAD_DIR=/data/uploads

# Production must never silently accept process-memory persistence.
ALLOW_MEMORY_FALLBACK=false

# Seed records are for explicit demos/tests only. Keep false for real data.
DEMO_SEED=false

# Keep test orders in the same normalized schema. Change to `live` only when
# the shop starts accepting real customers.
ORDER_DATA_MODE=test

# SePay + VietQR. Secrets must be set in the deployment environment, never in git.
SEPAY_BANK_ACCOUNT=replace-with-linked-bank-account
SEPAY_BANK_CODE=TPBank
SEPAY_PAYMENT_PREFIX=TPHO
SEPAY_PAYMENT_WINDOW_MINUTES=15
SEPAY_STORE_NAME=Tao Pho 88
SEPAY_WEBHOOK_AUTH_MODE=hmac
SEPAY_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Lalamove API. Start in sandbox; production booking is blocked while
# ORDER_DATA_MODE=test and until LALAMOVE_AUTO_BOOK=true is explicitly enabled.
LALAMOVE_ENABLED=false
LALAMOVE_ENV=sandbox
LALAMOVE_API_KEY=pk_test_replace-from-partner-portal
LALAMOVE_API_SECRET=sk_test_replace-from-partner-portal
LALAMOVE_MARKET=VN
LALAMOVE_LANGUAGE=vi_VN
LALAMOVE_SERVICE_TYPE=MOTORCYCLE
LALAMOVE_AUTO_BOOK=false
LALAMOVE_PICKUP_LEAD_MINUTES=10
LALAMOVE_MATCH_TIMEOUT_MINUTES=5
LALAMOVE_MAX_FEE_VND=100000
LALAMOVE_MAX_DISTANCE_METERS=25000
